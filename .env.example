# =============================================================================
# WebMonitor 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入真实值。带"必填"标记的变量没有可用默认值，
# 留空会导致启动失败——这是刻意设计，避免示例密钥进入生产。

# =============================================================================
# 镜像来源
# =============================================================================
# 公开应用镜像；docker compose up -d --wait 默认匿名拉取。
# :latest 跟随稳定发布；需要固定版本时改为 :1.0.2。
# 源码开发使用 compose.build.yaml 与独立本地镜像标签。
WEBMONITOR_IMAGE=ghcr.io/webmonitor/webmonitor:latest

# =============================================================================
# 应用安全配置
# =============================================================================

# JWT 密钥，必填，至少 32 个字符。生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 首次启动引导管理员账户。
# 数据库里已有管理员时这些值不会被使用，也不会重置已有密码。
# 没有管理员且 ADMIN_PASSWORD 为空时，服务会拒绝启动。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# =============================================================================
# 应用配置
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO

# 默认只采集公网 HTTP(S) 页面。仅为明确授权的内网目标填写精确 origin；不含路径。
# 例如 http://site:9000；多个用逗号分隔，禁止加入管理端口。
TARGET_ALLOWED_ORIGINS=

# =============================================================================
# 数据库配置
# =============================================================================
DATABASE_URL=sqlite:///./data/webmonitor.db

# =============================================================================
# 访问地址
# =============================================================================
# 前后端同源发布：FastAPI 同时提供 API 与前端页面，只有一个端口。
# 页面:     http://localhost:8000/
# API 文档: http://localhost:8000/docs
# 页面与 API 之间没有跨域请求，因此不需要任何 CORS 或前端 API 地址配置。
