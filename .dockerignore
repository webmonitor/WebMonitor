pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Dependency directories
# Patterns are matched against the root context, so nested copies must be named
# explicitly: both images build from the repository root.
node_modules/
frontend/node_modules/
**/node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
frontend/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
