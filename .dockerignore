# Development
# Root-level dependency manifest is required by deploy/Dockerfile.
!requirements.txt
!pyproject.toml
# 任何位置的 .env 都不属于构建上下文（.env 里有真实凭据）
.env
.env.*
**/.env
**/.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

